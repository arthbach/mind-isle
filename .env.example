# Copy to .env.local and fill in. Everything is optional:
# with no VAULT_PATH the app runs on a copy of ./demo-vault.

# Absolute path to your Obsidian vault.
# VAULT_PATH=/Users/you/Documents/My Vault

# Vault name as Obsidian knows it (used for "Open in Obsidian" links).
# Defaults to the folder name of VAULT_PATH.
# PALACE_VAULT_NAME=My Vault

# Your name, shown in greetings and on the public Trophy Hall.
# PALACE_OWNER_NAME=Traveler

# Page title.
# PALACE_TITLE=Mind Isle

# Folder (inside the vault) where daily notes are written: <folder>/YYYY-MM-DD.md
# PALACE_DAILY_DIR=01 Daily

# Folders to skip. Matches a folder named exactly this, or ending in " <name>" (so "Archive" also skips "07 Archive").
# PALACE_EXCLUDE=.obsidian,.trash,.git,node_modules,Templates,Archive,_attachments

# Notes or tasks with any of these tags are private: hidden from the public Hall.
# PALACE_PRIVATE_TAGS=private,career,personal

# Timezone used to decide what "today" is.
# PALACE_TIMEZONE=Europe/Lisbon

# Where to look for agent sessions (auto-detected; set only if yours live elsewhere).
# PALACE_CLAUDE_DIR=/path/to/.claude
# PALACE_CODEX_DIR=/path/to/.codex
# PALACE_ORCA_DIR=/path/to/orca-app-data

# Where the app keeps its own small state (decision verdicts, demo vault copy).
# PALACE_DATA_DIR=.palace

# Set a passcode before opening the app to your phone or network.
# Everything except /hall (public trophies) and /login then requires it.
# PALACE_PASSCODE=
# PALACE_SECRET=any-random-string

# true = never write to the vault (check-ins and buttons are disabled).
# PALACE_READ_ONLY=false
